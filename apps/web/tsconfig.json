{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@pokemon-battle/shared": ["../../packages/shared/types.ts"]
    }
  },
  "include": ["app/**/*", "../../packages/shared/**/*"]
}
